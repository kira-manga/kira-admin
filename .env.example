# The backend contacted by Next.js on the server. No browser CORS access is required.
KIRA_BACKEND_URL=https://api.kiramanga.me
# Opt in only after the trusted ingress/network prerequisites in README are verified.
# true requires the exact KIRA_BACKEND_URL=http://backend:8080; unset/false stays off.
KIRA_ADMIN_TRUSTED_INGRESS=false
# Exact public origin used for same-origin and CSRF validation in production.
KIRA_ADMIN_ORIGIN=https://admin.kiramanga.me
