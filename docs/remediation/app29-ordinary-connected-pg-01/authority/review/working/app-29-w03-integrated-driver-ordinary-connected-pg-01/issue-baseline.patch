+        val lives = java.lang.reflect.Array.newInstance(types.life, inputs.lives.size)
+        inputs.lives.forEachIndexed { index, life ->
+            check(life.access === this)
+            java.lang.reflect.Array.set(lives, index, life.cell)
+        }
