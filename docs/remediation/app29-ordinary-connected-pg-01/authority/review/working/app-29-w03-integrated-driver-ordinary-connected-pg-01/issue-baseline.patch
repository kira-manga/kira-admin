+
+    internal fun hasOrdinaryOnlyProvenance(): Boolean = compatibilityOnly.get()
+
+    internal fun hasCurrentFrame(): Boolean = frames.get() != null
+
+    internal fun exposedNativeCount(): Int = exposedNative.size
