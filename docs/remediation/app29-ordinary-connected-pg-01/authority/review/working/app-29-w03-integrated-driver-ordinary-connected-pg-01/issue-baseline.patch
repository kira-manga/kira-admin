+    }
+
+    internal fun prepareDriverInvocation(
+        call: PersistenceJdbcGuardCall,
+        native: Any,
+        method: Method,
+        arguments: Array<Any?>,
+        inputs: PhysicalJdbcInputs,
+    ): PersistencePgOwnedCutAccess.Invocation? {
