+            check(phase.compareAndSet(Phase.OPEN, Phase.RETURNING))
+            val attempt = PersistenceJdbcPoolTransfer.prepare(ownership, state, PersistenceJdbcPoolTransfer.Kind.RETURN, budget, requireNotNull(returnCaller))
