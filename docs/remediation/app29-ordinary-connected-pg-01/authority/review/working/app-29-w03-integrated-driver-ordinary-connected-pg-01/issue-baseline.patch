+internal fun invokeTransportOutputArgument(output: OutputStream, vector: String) {
+    when (vector) {
+        "ZERO_ARRAY" -> output.write(ByteArray(0))
+        "WRITE_NULL" -> output.write(null)
+        "SLICE_NULL" -> output.write(null, 0, 0)
