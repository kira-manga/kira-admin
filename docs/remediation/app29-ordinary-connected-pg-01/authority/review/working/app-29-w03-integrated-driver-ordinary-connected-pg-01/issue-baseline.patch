+            addAll(
+                phase("complaint_journal_scan_runs", "chk_complaint_scan_times", "finished_at", setup = {
+                    exec("UPDATE complaint_journal_scan_runs SET state='COMPLETE',manifest_hash=$FIXTURE_DIGEST,finished_at=$FIXTURE_INSTANT")
+                }),
