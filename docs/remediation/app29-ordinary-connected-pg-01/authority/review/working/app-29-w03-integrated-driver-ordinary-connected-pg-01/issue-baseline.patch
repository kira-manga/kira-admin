+        END_OPENING,
+        OPENING_STATE,
+        CLEANUP_OPENING,
+        ATTACH,
+        OWNER,
+        LIFE,
+        IS_LIVE,
+        REVOKE,
+        LIFE_KIND,
+        FIRST_CLOSE_STATE,
+        LIVE_NATIVE_CHILDREN,
+        ROOT_STATE,
+        RETENTION_STATE,
