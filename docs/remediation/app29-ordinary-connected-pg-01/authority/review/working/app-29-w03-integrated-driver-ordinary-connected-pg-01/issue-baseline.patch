+    companion object {
+        private const val WRITER = "64000000-0000-4000-8000-000000000001"
+    }
+}
+
+fun controlUpdate(set: String): String = "UPDATE complaint_journal_control SET $set WHERE data_scope_id='$LIVE_SCOPE'"
