+        error("Synthetic model resource must not be rendered.")
+    }
+
+    override fun equals(other: Any?): Boolean {
+        comparisons.incrementAndGet()
+        return this === other
+    }
+
+    override fun hashCode(): Int {
+        comparisons.incrementAndGet()
+        return 1
+    }
+}
