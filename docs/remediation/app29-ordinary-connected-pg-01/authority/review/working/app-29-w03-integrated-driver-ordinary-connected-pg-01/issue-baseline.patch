+    }
+
+    // Publish every adoption failure before failure boxing and preserve the original Throwable rethrow.
+    @Suppress("TooGenericExceptionCaught")
+    internal fun adoptDriverLife(
+        identity: PersistenceJdbcGuardIdentity,
+        native: Any,
