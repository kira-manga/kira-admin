+    val jar = Path.of(input("jar")).toRealPath()
+    val checker = Path.of(input("checker")).toRealPath()
+    fun sha256(path: Path): String = MessageDigest.getInstance("SHA-256").digest(Files.readAllBytes(path))
+        .joinToString("") { "%02x".format(it) }
