+  /** Capture the actual Life before the original call's actualEnd compacts closed receivers. */
+  private static KiraOwnedJdbcCut.Life liveNativeLife(PgConnection connection, Class<?> type) {
+    KiraOwnedJdbcCut.Life found = null;
+    for (KiraOwnedJdbcCut.Native child = connection.kira.children; child != null; child = child.next) {
+      if (child.receiver != null && child.receiver.getClass() == type) {
+        assertNull(found, "Expected only one matching native receiver in this getter extent.");
+        assertTrue(child.factoryReturned);
+        assertEquals(0, KiraOwnedJdbcCut.firstCloseState(child.life));
+        found = child.life;
+      }
+    }
+    return Objects.requireNonNull(found, "The actual native getter receiver was not constructed.");
+  }
